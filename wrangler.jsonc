{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "athena",
	"compatibility_date": "2026-05-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "athena"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "athena-db",
			"database_id": "fa6a5a4f-ee91-4d3e-9183-3f90e9f0a464",
			"migrations_dir": "src/db/migrations",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "f2274cb066714e51ba6fc9087b1989bc",
			"remote": true
		}
	]
}